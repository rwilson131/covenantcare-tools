#!/usr/bin/env bash
# CovenantCare Document PDF Generator
# Usage: generate-pdf [--doctype "Policy"] [--confidential] [--output out.pdf] input.md
set -e
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
exec bun "$SCRIPT_DIR/../generate-pdf.ts" "$@"
